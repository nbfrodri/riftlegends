{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"],
		"jsx": "react-jsx"
	},
	"include": [
		"apps/**/*.ts",
		"apps/**/*.tsx",
		"packages/**/*.ts",
		"packages/**/*.tsx",
		"vitest.config.ts",
		"vitest.goldens.config.ts"
	],
	"exclude": ["**/node_modules", "packages/core/test/fixtures"]
}
