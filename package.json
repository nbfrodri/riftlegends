{
	"name": "rift-legends",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.22.0",
	"scripts": {
		"postinstall": "pnpm --filter @rift-legends/desktop exec install-electron",
		"dev": "pnpm --filter @rift-legends/desktop dev",
		"data:snapshot": "node tools/data-pipeline/cli.ts",
		"data:champions": "node tools/data-pipeline/champions-cli.ts",
		"data:content": "node tools/data-pipeline/content.ts",
		"data:logos": "node tools/data-pipeline/cli.ts logos",
		"data:photos": "node tools/data-pipeline/cli.ts photos",
		"data:leagues": "node tools/data-pipeline/cli.ts leagues",
		"data:league-formats": "node tools/data-pipeline/cli.ts league-formats",
		"data:internationals": "node tools/data-pipeline/cli.ts internationals",
		"data:timelines": "node tools/data-pipeline/cli.ts timelines",
		"data:summoners": "node tools/data-pipeline/cli.ts summoners",
		"e2e": "pnpm --filter @rift-legends/desktop build && pnpm --filter @rift-legends/desktop e2e",
		"e2e:visual": "pnpm --filter @rift-legends/desktop build && pnpm --filter @rift-legends/desktop e2e:visual",
		"lint": "biome check .",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"calibrate": "vitest run --config vitest.calibration.config.ts",
		"goldens:update": "vitest run --config vitest.goldens.config.ts",
		"mutation": "stryker run",
		"knip": "knip",
		"verify": "biome ci && tsc -b && vitest run && pnpm knip"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@stryker-mutator/core": "10.1.1",
		"@stryker-mutator/vitest-runner": "10.1.1",
		"@types/node": "26.6.6",
		"happy-dom": "21.0.4",
		"knip": "6.48.0",
		"lefthook": "2.2.2",
		"typescript": "7.0.2",
		"vitest": "5.1.1"
	}
}
