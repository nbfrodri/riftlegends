{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!**/*.md",
			"!.github/ISSUE_TEMPLATE",
			"!design",
			"!docs/research",
			"!packages/core/test/fixtures",
			"!tools/data-pipeline/fixtures/leaguepedia",
			"!packages/core/content/real/*.json",
			"!pnpm-lock.yaml",
			"!.claude/settings.local.json",
			"!.claude/skills",
			"!.claude/agents",
			"!.agents",
			"!.codex/agents",
			"!.opencode"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"linter": {
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.css"],
			"css": { "parser": { "tailwindDirectives": true } }
		},
		{
			"includes": ["packages/core/**", "!packages/core/test/**"],
			"linter": {
				"rules": {
					"complexity": {
						"useMathMinMax": "off"
					},
					"style": {
						"noRestrictedGlobals": {
							"level": "error",
							"options": {
								"deniedGlobals": {
									"Math": "Use deterministic arithmetic and a seeded PRNG in core.",
									"Date": "Pass in the game day instead of reading the wall clock.",
									"performance": "Keep elapsed time outside core.",
									"PerformanceMark": "Keep platform timestamps outside core.",
									"PerformanceObserver": "Keep performance measurements outside core.",
									"crypto": "Use the seeded PRNG in core.",
									"Temporal": "Pass in game time instead of consulting Temporal.Now.",
									"process": "Keep Node.js clocks and process state outside core.",
									"require": "Use static imports so core dependencies can be checked.",
									"globalThis": "Keep host globals outside core.",
									"global": "Keep host globals outside core.",
									"self": "Keep host globals outside core.",
									"Intl": "Format dates and times outside core.",
									"Event": "Keep platform events and their timestamps outside core.",
									"setTimeout": "Drive simulation steps with game time.",
									"setInterval": "Drive simulation steps with game time.",
									"setImmediate": "Drive simulation steps with game time.",
									"AbortSignal": "Keep platform timers outside core.",
									"requestIdleCallback": "Keep idle timing outside core.",
									"requestAnimationFrame": "Keep animation frame timing outside core.",
									"window": "Keep DOM access outside core.",
									"document": "Keep DOM access outside core."
								}
							}
						},
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"electron": "Keep Electron APIs outside core.",
									"react": "Keep UI dependencies outside core."
								},
								"patterns": [
									{
										"group": [
											"node:*",
											"node:*/**",
											"fs",
											"fs/**",
											"crypto",
											"perf_hooks",
											"process",
											"os",
											"timers",
											"timers/**"
										],
										"message": "Keep Node.js APIs outside core."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
