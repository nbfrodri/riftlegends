{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!**/*.md",
			"!.github/ISSUE_TEMPLATE",
			"!design",
			"!pnpm-lock.yaml"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"linter": {
		"rules": {
			"preset": "recommended"
		}
	}
}
